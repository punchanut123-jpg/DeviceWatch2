# ────────────────────────────────────────────────────────────
# DeviceWatch — Production Environment Template (.env.example)
# ────────────────────────────────────────────────────────────

# Database Connection (MySQL 8.0)
DATABASE_URL="mysql://devicewatch_user:YOUR_STRONG_DB_PASSWORD@localhost:3306/devicewatch"

# JWT Secret (MUST be a long, random string in Production! e.g., generated with `openssl rand -hex 32`)
JWT_SECRET="PLEASE_REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_FOR_PRODUCTION_SECURITY"

# Admin Account Credentials (Change before initial launch!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_THIS_TO_SECURE_ADMIN_PASSWORD"

# Teacher Account Credentials (Change before initial launch!)
TEACHER_USERNAME="teacher"
TEACHER_PASSWORD="CHANGE_THIS_TO_SECURE_TEACHER_PASSWORD"

# LINE Messaging API Credentials (From LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE"
LINE_CHANNEL_SECRET="YOUR_LINE_CHANNEL_SECRET_HERE"

# CORS Configuration (Allowed Production Domains, comma-separated)
CORS_ORIGIN="http://localhost:5173,https://devicewatch.yourdomain.com"

# Server Port
PORT=3000
